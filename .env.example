PORT=3001
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Supabase Dashboard > Connect > Session pooler (port 5432).
# Copy the URL exactly, then percent-encode special characters in the password.
# Keep this server-only: never prefix it with VITE_.
DATABASE_URL=
APP_TIMEZONE=Africa/Lagos
DB_POOL_SIZE=5
DB_SSL=true
# Optional Supabase root CA certificate path; TLS verification remains enabled.
DB_SSL_CA_FILE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional: leave empty to disable password-reset email until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ZendX Social <no-reply@example.com>
# OAuth callbacks: APP_URL/api/oauth/PROVIDER/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Public HTTPS origin used by social providers to download uploaded media.
PUBLIC_MEDIA_ORIGIN=
