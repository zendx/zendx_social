{
  "name": "zendx-social",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node api.js && concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "node api.js && vite build",
    "start": "node api.js && node server/index.js",
    "db:setup": "node server/setup.js",
    "db:check": "node server/check-db.js",
    "worker": "node server/worker.js",
    "worker:watch": "node server/worker.js --watch",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:db": "node tests/database-integration.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.57.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "vite": "^8.3.4"
  }
}
